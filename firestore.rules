rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function membershipId(organizationId) {
      return request.auth.uid + "-" + organizationId;
    }

    function activeMembership(organizationId) {
      return signedIn() &&
        exists(/databases/$(database)/documents/memberships/$(membershipId(organizationId))) &&
        get(/databases/$(database)/documents/memberships/$(membershipId(organizationId))).data.status == "ACTIVE";
    }

    function activeAdmin(organizationId) {
      return activeMembership(organizationId) &&
        get(/databases/$(database)/documents/memberships/$(membershipId(organizationId))).data.role == "ADMIN";
    }

    function isInspectionViewer(data) {
      return activeAdmin(data.organizationId) ||
        (signedIn() && data.inspectorId == request.auth.uid) ||
        (signedIn() && data.tenantIds is list && data.tenantIds.hasAny([request.auth.uid]));
    }

    match /users/{userId} {
      allow read, write: if signedIn();
    }

    match /organizations/{organizationId} {
      allow read: if activeMembership(organizationId);
      allow write: if activeAdmin(organizationId);
    }

    match /memberships/{membershipId} {
      allow read: if signedIn() && (
        resource.data.userId == request.auth.uid ||
        activeAdmin(resource.data.organizationId)
      );

      allow create: if signedIn();

      allow update: if signedIn() && (
        resource.data.userId == request.auth.uid ||
        activeAdmin(resource.data.organizationId)
      );

      allow delete: if activeAdmin(resource.data.organizationId);
    }

    match /inviteCodes/{code} {
      allow read: if signedIn();
      allow write: if signedIn();
    }

    match /buildings/{buildingId} {
      allow read: if signedIn() && activeMembership(resource.data.organizationId);
      allow create: if signedIn() && activeAdmin(request.resource.data.organizationId);
      allow update, delete: if signedIn() && activeAdmin(resource.data.organizationId);
    }

    match /rooms/{roomId} {
      allow read: if signedIn() && activeMembership(resource.data.organizationId);
      allow create: if signedIn() && activeAdmin(request.resource.data.organizationId);
      allow update, delete: if signedIn() && activeAdmin(resource.data.organizationId);
    }

    match /inspections/{inspectionId} {
      allow read: if signedIn() && isInspectionViewer(resource.data);
      allow create: if signedIn() && activeAdmin(request.resource.data.organizationId);
      allow update: if signedIn() && (
        activeAdmin(resource.data.organizationId) ||
        resource.data.inspectorId == request.auth.uid
      );
      allow delete: if signedIn() && activeAdmin(resource.data.organizationId);
    }

    match /inspectionItems/{itemId} {
      allow read: if signedIn();
      allow create, update: if signedIn();
      allow delete: if false;
    }

    match /media/{mediaId} {
      allow read: if signedIn();
      allow create, update: if signedIn();
      allow delete: if false;
    }

    match /charges/{chargeId} {
      allow read, write: if signedIn();
    }
  }
}
